generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum ImportStatus {
  PENDING
  PROCESSING
  MAPPING
  NORMALIZING
  ENRICHING
  REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportSourceType {
  CSV
  XLSX
  XLS
  JSON
  API
  MANUAL
}

enum ImportRowStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

enum ProductStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ProductChangeType {
  CREATED
  UPDATED
  DELETED
  IMPORTED
  ENRICHED
  APPROVED
  REJECTED
  PUBLISHED
}

enum EnrichmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum EnrichmentType {
  TITLE
  DESCRIPTION
  SHORT_DESCRIPTION
  SEO_TITLE
  SEO_DESCRIPTION
  TAGS
  CATEGORY
  ATTRIBUTES
  KEYWORDS
  BULLET_POINTS
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum ReviewItemType {
  PRODUCT
  IMPORT
  ENRICHMENT
  FIELD
}

enum IntegrationType {
  SHOPIFY
  WOOCOMMERCE
  MAGENTO
  CUSTOM_API
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum PublishStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum JobType {
  IMPORT
  PARSE
  MAP_FIELDS
  NORMALIZE
  CATEGORIZE
  ENRICH
  VALIDATE
  PUBLISH
  SYNC
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  APPROVE
  REJECT
  PUBLISH
  LOGIN
  LOGOUT
  INTEGRATION
}

// ============================================================
// ORGANIZATION / AUTH
// ============================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     OrganizationMember[]
  createdProducts Product[] @relation("ProductCreatedBy")
  reviews         Review[] @relation("ReviewCreatedBy")
  auditLogs       AuditLog[]

  @@index([email])
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         OrganizationMember[]
  suppliers       Supplier[]
  imports         Import[]
  products        Product[]
  categories      Category[]
  integrations   Integration[]
  jobs            Job[]
  reviews         Review[]
  auditLogs       AuditLog[]
  aiUsage         AIUsage[]
  importMappings  ImportMapping[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole @default(MEMBER)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id             String         @id @default(cuid())
  organizationId String

  name           String
  code           String?
  email          String?
  website        String?
  status         SupplierStatus @default(ACTIVE)

  // Used to remember how this supplier structures its files.
  mappingProfile Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  imports      Import[]
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================
// IMPORTS
// ============================================================

model Import {
  id             String           @id @default(cuid())
  organizationId String
  supplierId     String?

  name           String
  sourceType     ImportSourceType
  status         ImportStatus     @default(PENDING)

  originalFileName String?
  fileUrl          String?

  totalRows       Int @default(0)
  processedRows    Int @default(0)
  failedRows      Int @default(0)

  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?

  metadata       Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  rows          ImportRow[]
  mappings      ImportMapping[]
  jobs          Job[]
  products      Product[]

  @@index([organizationId, status])
  @@index([supplierId])
  @@index([createdAt])
}

model ImportRow {
  id         String          @id @default(cuid())
  importId   String
  rowNumber  Int

  rawData    Json
  normalized Json?

  status     ImportRowStatus @default(PENDING)
  error      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, status])
}

model ImportMapping {
  id             String   @id @default(cuid())
  organizationId String
  importId       String?
  supplierId     String?

  sourceField    String
  targetField    String

  confidence     Float?
  mappingMethod  String?

  approved       Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import       Import?      @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([importId])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id             String        @id @default(cuid())
  organizationId String
  supplierId     String?
  importId       String?

  externalId     String?
  sku            String

  name           String
  slug           String?

  description    String?
  shortDescription String?

  brand          String?
  manufacturer   String?
  barcode        String?
  gtin           String?
  mpn            String?

  status         ProductStatus @default(DRAFT)

  // Flexible product-specific fields.
  attributes     Json?

  // Original supplier information preserved for traceability.
  sourceData     Json?

  // AI-generated fields and metadata.
  enrichmentData Json?

  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  import       Import?      @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  categoryAssignments ProductCategory[]
  enrichments         ProductEnrichment[]
  changes             ProductChange[]
  reviews             Review[]
  publications        Publication[]

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id             String   @id @default(cuid())
  organizationId String

  name           String
  slug           String

  description    String?

  parentId       String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products ProductCategory[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

model ProductCategory {
  productId  String
  categoryId String

  confidence Float?
  source     String?

  createdAt DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

// ============================================================
// AI ENRICHMENT
// ============================================================

model ProductEnrichment {
  id        String          @id @default(cuid())
  productId String

  type      EnrichmentType
  status    EnrichmentStatus @default(PENDING)

  input     Json?
  output    Json?

  provider  AIProvider?
  model     String?

  confidence Float?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@index([status])
}

model AIUsage {
  id             String     @id @default(cuid())
  organizationId String

  provider       AIProvider
  model          String

  operation      String

  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?

  estimatedCost  Decimal?   @db.Decimal(12, 6)

  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ============================================================
// PRODUCT HISTORY
// ============================================================

model ProductChange {
  id        String            @id @default(cuid())
  productId String

  type      ProductChangeType

  field     String?
  oldValue  Json?
  newValue  Json?

  source    String?
  metadata  Json?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id             String       @id @default(cuid())
  organizationId String
  productId      String?
  createdById    String

  type           ReviewItemType
  status         ReviewStatus @default(PENDING)

  title          String?
  notes          String?

  metadata       Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ReviewCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([productId])
}

// ============================================================
// INTEGRATIONS
// ============================================================

model Integration {
  id             String            @id @default(cuid())
  organizationId String

  type           IntegrationType
  name           String

  status         IntegrationStatus @default(ACTIVE)

  // Encrypted credentials/configuration.
  credentials    Json?

  settings       Json?

  lastSyncAt     DateTime?
  lastError      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  publications Publication[]

  @@index([organizationId, type])
}

model Publication {
  id             String        @id @default(cuid())
  productId      String
  integrationId  String

  externalId     String?

  status         PublishStatus @default(PENDING)

  publishedData  Json?

  errorMessage   String?

  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  integration  Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([productId, integrationId])
  @@index([integrationId, status])
}

// ============================================================
// BACKGROUND JOBS
// ============================================================

model Job {
  id             String    @id @default(cuid())
  organizationId String
  importId       String?

  type           JobType
  status         JobStatus @default(PENDING)

  // BullMQ job ID.
  queueJobId     String?

  progress       Int       @default(0)

  payload        Json?
  result         Json?

  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)

  errorMessage   String?

  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import       Import?      @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([importId])
  @@index([type, status])
  @@index([queueJobId])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?

  action         AuditAction

  entityType     String
  entityId       String?

  oldData        Json?
  newData        Json?

  ipAddress      String?
  userAgent      String?

  metadata       Json?

  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([userId])
}
